---
import Base from '../layouts/Base.astro';
import Board from '../components/Board.astro';
import RotatingText from '../components/RotatingText.astro';
import DeedCard from '../components/DeedCard.astro';
import Img from '../components/Img.astro';
import { caseStudies, playground } from '../data/projects';

const words = ['people.', 'innovation.', 'curiosity.', 'good stories.', 'design that feels human.', 'beauty in the details.'];
---
<Base active="home">
  <Board>
    <div class="hero">
      <h1>
        Hi, I’m Joselyn.<br />
        <span class="driven">I’m driven by <RotatingText words={words} /></span>
      </h1>
      <p class="sub">
        Marketing + Entrepreneurship at WashU, minoring in Human-Computer Interaction.
        A beauty, fashion, and tech enthusiast who studies how people think, then designs what they’ll love.
      </p>
      <form class="ask" role="search" action="#" aria-label="Ask me anything">
        <label class="sr-only" for="ask">Ask me anything</label>
        <input id="ask" type="text" placeholder="Ask me anything…" autocomplete="off" data-search-proxy />
        <button type="button" data-search-open aria-label="Open search">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
      <div class="chips">
        <button class="chip" type="button" data-search-open data-q="UX">Show me UX work</button>
        <button class="chip" type="button" data-search-open data-q="campaign">Marketing campaigns</button>
        <button class="chip" type="button" data-search-open data-q="tools">What tools do you use?</button>
      </div>
    </div>
  </Board>

  <section class="wrap block" aria-labelledby="work-h">
    <div class="block-head">
      <div>
        <p class="eyebrow">Case studies</p>
        <h2 id="work-h">Pick a property.</h2>
      </div>
      <a class="btn ghost" href="/projects">All projects</a>
    </div>
    <div class="deeds">
      {caseStudies.map((item) => <DeedCard item={item} />)}
    </div>
  </section>

  <section class="wrap block" aria-labelledby="play-h">
    <div class="block-head">
      <div>
        <p class="eyebrow">Playground</p>
        <h2 id="play-h">Off the board.</h2>
        <p class="muted">Textiles, posters, reels, a fragrance brand I dream about, and a research paper on AI media.</p>
      </div>
      <a class="btn ghost" href="/playground">Visit the playground</a>
    </div>
    <div class="strip">
      <a href="/playground/textiles" class="strip-item" data-face="5"><Img src="/images/textiles/creamsicle-bodice-flat.webp" alt="Creamsicle print bodice mockup" zoom={false} /><span>Textiles</span></a>
      <a href="/playground/design-social" class="strip-item" data-face="6"><Img src="/images/design/kiki-bouba.webp" alt="Find the Kiki to your Bouba poster" zoom={false} /><span>Posters</span></a>
      <a href="/playground/jdel" class="strip-item" data-face="1"><Img src="/images/jdel/bottle.webp" alt="JDel perfume bottle render" zoom={false} /><span>JDel</span></a>
      <a href="/playground/textiles" class="strip-item" data-face="5"><Img src="/images/textiles/bead-singer.webp" alt="Jazz singer bead curtain print" zoom={false} /><span>Print design</span></a>
      <a href="/playground/design-social" class="strip-item" data-face="6"><Img src="/images/design/tinydesk-black.webp" alt="WUTV Tiny Desk concert poster" zoom={false} /><span>WUTV</span></a>
      <a href="/playground/raised-on-the-blur" class="strip-item type" data-face="2"><span class="type-q">“Raised on the Blur”</span><span>Writing</span></a>
    </div>
  </section>
</Base>

<style>
  .hero { max-width: 680px; }
  .hero h1 { font-size: clamp(2.5rem, 5.4vw, 4.4rem); margin-bottom: 0.35em; }
  .driven { display: inline-block; min-height: 1.1em; }
  .sub { color: var(--ink-2); font-size: 1.05rem; max-width: 560px; margin: 0 auto 26px; }
  .ask {
    display: flex; align-items: center; gap: 8px; max-width: 560px; margin: 0 auto; padding: 8px 8px 8px 24px;
    background: var(--white); border-radius: 999px; border: 1px solid var(--line); box-shadow: var(--shadow-lg);
  }
  .ask input { flex: 1; border: 0; outline: 0; font: inherit; font-size: 1.05rem; background: transparent; color: var(--ink); min-width: 0; }
  .ask button { width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--ink); color: #fff; display: grid; place-items: center; cursor: pointer; box-shadow: 0 0 0 4px rgba(255, 0, 191, 0.12); transition: transform 0.25s var(--ease); }
  .ask button:hover { transform: scale(1.06); }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; }

  .block { padding-top: 96px; }
  .block-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 28px; flex-wrap: wrap; }
  .block-head h2 { margin: 0; }
  .block-head .muted { margin: 8px 0 0; }
  .deeds { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; }

  .strip { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(200px, 1fr); gap: 16px; overflow-x: auto; padding: 6px 2px 18px; scroll-snap-type: x mandatory; }
  .strip-item { position: relative; display: block; height: 280px; border-radius: var(--radius); overflow: hidden; scroll-snap-align: start; text-decoration: none; border: 1.5px solid var(--ink); background: var(--white); }
  .strip-item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .strip-item:hover :global(img) { transform: scale(1.05); }
  .strip-item > span:last-child { position: absolute; left: 12px; bottom: 12px; background: var(--white); border-radius: 999px; padding: 4px 12px; font-size: 0.82rem; font-weight: 600; }
  .strip-item.type { display: grid; place-items: center; background: var(--write-tint); }
  .type-q { font-family: var(--serif); font-style: italic; font-size: 1.8rem; color: var(--write-text); text-align: center; padding: 20px; }
</style>
