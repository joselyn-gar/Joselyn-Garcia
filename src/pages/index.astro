---
import Base from '../layouts/Base.astro';
import Board from '../components/Board.astro';
import RotatingText from '../components/RotatingText.astro';
import Marquee from '../components/Marquee.astro';
import { caseStudies } from '../data/projects';

const words = ['curiosity and creativity.', 'innovation and impact.', 'purpose and passion.'];
---
<Base active="home">
  <Board>
    <div class="hero">
      <h1>
        Hi, I’m Joselyn.<br />
        <span class="driven">I’m driven by<br /><RotatingText words={words} /></span>
      </h1>
      <p class="sub">
        Marketing + Entrepreneurship at WashU, minoring in Human-Computer Interaction.
        A beauty, fashion, and tech enthusiast who studies how people think, then designs what they’ll love.
      </p>
      <form class="ask" role="search" action="#" aria-label="Ask me anything">
        <label class="sr-only" for="ask">Ask me anything</label>
        <input id="ask" type="text" placeholder="Ask me anything…" autocomplete="off" data-search-proxy />
        <button type="button" data-search-open aria-label="Open search">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
      <div class="chips">
        <button class="chip" type="button" data-search-open data-q="UX">Show me UX work</button>
        <button class="chip" type="button" data-search-open data-q="campaign">Marketing campaigns</button>
        <button class="chip" type="button" data-search-open data-q="tools">What tools do you use?</button>
      </div>
    </div>
  </Board>

  <section class="wrap block" aria-labelledby="work-h">
    <p class="eyebrow center">Case studies</p>
    <h2 id="work-h" class="big">Selected work.</h2>
    <div class="work">
      {caseStudies.map((p) => (
        <a class="work-card" href={p.href} data-face={p.face} style={`--c:var(--${p.color});--t:var(--${p.color}-tint);--ct:var(--${p.color}-text)`}>
          <span class="work-img"><img src={p.cover} alt="" loading="lazy" /></span>
          <span class="work-meta">
            <span class="work-tags">{p.tags.slice(0, 2).join(' · ')}</span>
            <span class="work-title">{p.title}</span>
            <span class="work-sum" set:html={p.summary}></span>
            <span class="work-cta">Read case study <span aria-hidden="true">→</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="block play" aria-labelledby="play-h">
    <p class="eyebrow center">Playground</p>
    <h2 id="play-h" class="big">Off the board.</h2>
    <p class="lede center">Textiles, posters, reels, and a fragrance brand I dream about.</p>
    <Marquee height="clamp(260px, 30vw, 400px)" items={[
      { src: '/images/textiles/gallery/wrap-top.webp', alt: 'Wrap top', href: '/playground/textiles', label: 'Textiles' },
      { src: '/images/design/kiki-bouba.webp', alt: 'Find the Kiki to your Bouba poster', href: '/playground/design-social', label: 'Posters' },
      { src: '/images/jdel/bottle.webp', alt: 'JDel perfume bottle render', href: '/playground#jdel', label: 'JDel' },
      { src: '/images/textiles/gallery/shibori-kaleidoscope.webp', alt: 'Shibori dyed fabric', href: '/playground/textiles', label: 'Dye work' },
      { src: '/images/design/tinydesk-blue.webp', alt: 'WUTV Tiny Desk poster', href: '/playground/design-social', label: 'WUTV' },
      { src: '/images/textiles/gallery/party-animal.webp', alt: 'Party Animal embroidery', href: '/playground/textiles', label: 'Embroidery' },
    ]} />
    <p class="center"><a class="btn ghost" href="/playground">Visit the playground</a></p>
  </section>
</Base>

<style>
  .hero { max-width: 680px; }
  .hero h1 { font-size: clamp(2.5rem, 5.4vw, 4.4rem); margin-bottom: 0.35em; }
  .driven { display: inline-block; min-height: 2.1em; }
  .sub { color: var(--ink-2); font-size: 1.05rem; max-width: 560px; margin: 0 auto 26px; }
  .ask {
    display: flex; align-items: center; gap: 8px; max-width: 560px; margin: 0 auto; padding: 8px 8px 8px 24px;
    background: var(--white); border-radius: 999px; border: 1px solid var(--line); box-shadow: var(--shadow-lg);
  }
  .ask input { flex: 1; border: 0; outline: 0; font: inherit; font-size: 1.05rem; background: transparent; color: var(--ink); min-width: 0; }
  .ask button { width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--ink); color: #fff; display: grid; place-items: center; cursor: pointer; box-shadow: 0 0 0 4px rgba(255, 0, 191, 0.12); transition: transform 0.25s var(--ease); }
  .ask button:hover { transform: scale(1.06); }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; }

  .block { padding-top: 140px; }
  .center { text-align: center; }
  .big { text-align: center; font-size: clamp(2.8rem, 6vw, 4.6rem); letter-spacing: -0.01em; margin-bottom: 0.4em; }
  .play .lede { margin: 0 auto 40px; max-width: 560px; padding: 0 20px; }
  .play .btn { margin-top: 12px; }
  .work { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; margin-top: 48px; }
  .work-card { display: block; text-decoration: none; color: var(--ink); }
  .work-img { display: block; aspect-ratio: 16 / 10; border-radius: 24px; overflow: hidden; background: var(--t); box-shadow: 0 20px 50px rgba(26, 26, 26, 0.12); }
  .work-img img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.7s var(--ease); }
  .work-card:hover .work-img img { transform: scale(1.04); }
  .work-meta { display: block; padding: 22px 4px 0; }
  .work-tags { display: block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ct); }
  .work-title { display: block; font-family: var(--serif); font-weight: 400; font-size: 2.2rem; letter-spacing: -0.01em; margin: 6px 0 8px; }
  .work-sum { display: block; color: var(--ink-2); font-size: 1.05rem; max-width: 480px; }
  .work-cta { display: inline-block; margin-top: 14px; font-weight: 700; color: var(--ct); }
  .work-card:hover .work-cta { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) { .work { grid-template-columns: 1fr; } }
</style>
