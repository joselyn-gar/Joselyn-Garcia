---
import ProductLayout from '../../layouts/ProductLayout.astro';
import Video from '../../components/Video.astro';

const posters = [
  ['/images/design/tinydesk-black.webp', 'Poster: WUTV Tiny Desk Concert featuring Irene Han, with a blue retro microphone on black', '<strong>WUTV</strong> · Tiny Desk, <strong>direction A</strong>'],
  ['/images/design/tinydesk-blue.webp', 'Poster: WUTV Tiny Desk Concert on textured blue with a retro TV and QR code', '<strong>WUTV</strong> · Same brief, <strong>direction B</strong>'],
  ['/images/design/kiki-bouba.webp', 'Poster: Find the Kiki to your Bouba. Apply for the SVC, with chrome star and blob shapes', '<strong>Skandalaris</strong> · The <strong>bouba/kiki effect</strong> pitches finding a co-founder'],
  ['/images/design/perform.webp', 'Poster: Can you sing? Play an instrument? Maybe both? Well, perform! WUTV Tiny Desk Concerts', '<strong>WUTV</strong> · <strong>Performer call</strong>'],
];
---
<ProductLayout
  slug="design-social"
  section="playground"
  eyebrow="Posters, reels + recap videos"
  title="Design + Social"
  tagline="<strong>4+ years</strong> of content. I run social for the <strong>Skandalaris Center</strong> and <strong>WUTV</strong>."
  hero="/images/design/hero.webp"
  heroAlt="Four posters side by side: two WUTV Tiny Desk directions, the Kiki to your Bouba poster, and a performer call"
  summary={[
    ['Reach', '<strong>1,000+</strong> average views per Skandalaris post.'],
    ['Growth', 'A WUTV brand refresh grew membership <strong>3 → 20</strong>.'],
    ['Since', 'Editing video since <strong>2020</strong>.'],
  ]}
>
  <section class="chapter">
    <span class="num">01 · Posters</span>
    <h2>Made to get sign-ups.</h2>
    <p>Two directions for one brief is how I work: <strong>explore, then pick</strong>.</p>
    <div class="band posters">
      {posters.map(([src, alt, cap]) => (
        <figure><img src={src} alt={alt} loading="lazy" /><figcaption set:html={cap}></figcaption></figure>
      ))}
    </div>
    <figure class="band"><img src="/images/design/mod-portrait.webp" alt="Posterized illustration of a 60s mod woman in round sunglasses with the photo reference inset" loading="lazy" class="narrow" /><figcaption><strong>Personal</strong> · A 60s mod portrait from a photo reference</figcaption></figure>
  </section>

  <section class="chapter tinted">
    <span class="num">02 · Reels</span>
    <h2>Pacing is everything.</h2>
    <p>Film edits for fun in 2020 became <strong>recaps and reels</strong> built on pacing and emotion.</p>
    <div class="band reels">
      <Video name="skandalaris-welcome" frame="phone" label="Animated welcome post: Welcome! Your journey starts here" caption="Skandalaris · Welcome post" />
      <Video name="skandalaris-ie-awards" frame="phone" label="TikTok promoting the WashU I&E Awards" caption="Skandalaris · I&E Awards" />
      <Video name="wutv-tiny-desk" frame="phone" label="TikTok: sign up for our Tiny Desk Concert" caption="WUTV · Tiny Desk sign-ups" />
    </div>
  </section>

  <section class="chapter">
    <span class="num">Where it started</span>
    <h2>High school ASB.</h2>
    <p>Recaps for <strong>West High ASB</strong>, where I first learned to tell a story in 15 seconds.</p>
    <div class="band reels two">
      <Video name="asb-home-game" frame="phone" label="First home game recap reel" caption="Home game recap" />
      <Video name="asb-staff-breakfast" frame="phone" label="Staff appreciation breakfast recap reel" caption="Staff breakfast recap" />
    </div>
  </section>
</ProductLayout>

<style>
  .posters { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px 32px; text-align: left; }
  .posters figure { margin: 0; }
  img.narrow { max-width: 460px; margin: 0 auto; }
  .reels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: left; }
  .reels.two { grid-template-columns: repeat(2, 1fr); max-width: 640px; }
  @media (max-width: 640px) { .posters { grid-template-columns: 1fr; } .reels { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
</style>
