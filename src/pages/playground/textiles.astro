---
import ProductLayout from '../../layouts/ProductLayout.astro';
import Marquee from '../../components/Marquee.astro';

const pieces = [
  { src: '/images/design/mod-portrait.webp', alt: 'Posterized print of a 60s mod woman in round sunglasses, with the photo reference inset' },
  { src: '/images/textiles/gallery/wrap-top.webp', alt: 'Burgundy polka dot wrap top with a black waistband on a dress form' },
  { src: '/images/textiles/gallery/shibori-kaleidoscope.webp', alt: 'Blue, red, and yellow shibori-dyed fabric in a kaleidoscope pattern' },
  { src: '/images/textiles/gallery/party-animal.webp', alt: 'Embroidered Party Animal panel with a colorful giraffe, beads, and a chenille border' },
  { src: '/images/textiles/gallery/sunburst.webp', alt: 'Yellow and crimson sunburst dyed fabric' },
  { src: '/images/textiles/gallery/fabric-collage.webp', alt: 'Layered fabric collage of corduroy, velvet, tweed, and embroidery thread' },
  { src: '/images/textiles/gallery/shibori-crimson.webp', alt: 'Crimson and black shibori-dyed fabric with a diamond center' },
  { src: '/images/textiles/gallery/shibori-stripes.webp', alt: 'Periwinkle and crimson striped shibori-dyed fabric' },
  { src: '/images/textiles/gallery/shibori-ochre.webp', alt: 'Ochre and black shibori-dyed fabric' },
];
---
<ProductLayout
  slug="textiles"
  section="playground"
  eyebrow="Surface design + textiles course"
  title="Textiles"
  tagline="Two repeat prints, from <strong>mood board</strong> to <strong>colorways</strong> to a garment."
  hero="/images/textiles/cover.webp"
  heroAlt="Four textile pieces: a white bound-resist cuff, a layered fabric collage, a rainbow shibori dye, and an ochre and black shibori dye"
  heroTall
  summary={[
    ['The course', '<strong>Crochet</strong>, knitwear, tapestry, and <strong>dye</strong> techniques.'],
    ['What I made', 'Two <strong>repeat prints</strong> and a <strong>bodice</strong> concept.'],
    ['The twist', 'I defined a <strong>target customer</strong> before choosing colors.'],
  ]}
>
  <section class="chapter">
    <span class="num">01 · Creamsicle</span>
    <h2>Loud, joyful, and full of play.</h2>
    <p>A homage to designer <strong>Matty Bovan</strong>: 60s and 70s shapes, plaid, and the color of a creamsicle.</p>
    <figure class="band"><img src="/images/textiles/creamsicle-moodboard.webp" alt="Mood board with Matty Bovan looks, retro geometric patterns, plaid, a creamsicle, and an aqua to orange palette" loading="lazy" /><figcaption>Mood board</figcaption></figure>
  </section>

  <section class="chapter tinted">
    <span class="num">02 · Who it’s for</span>
    <h2>The marketer in me showed up.</h2>
    <p>Before the colorways, I defined <strong>the customer</strong>.</p>
    <ol class="band decisions">
      <li><i>1</i><div><b>18 to 30</b><span>Expressive. Builds outfits from <strong>thrifted</strong> and <strong>handmade</strong> pieces.</span></div></li>
      <li><i>2</i><div><b>Loves bold color</b><span>Clashing colors, <strong>nostalgia</strong>, and play.</span></div></li>
      <li><i>3</i><div><b>Buys the feeling</b><span>Prints that feel <strong>collectible</strong>, like a 90s childhood.</span></div></li>
    </ol>
    <p class="note">Experimental designer tier · NYC, LA, London, Seoul</p>
  </section>

  <section class="chapter">
    <span class="num">03 · Colorways</span>
    <h2>Three tries, one winner.</h2>
    <p>Pink, burgundy, and jewel tones first. The <strong>creamsicle</strong> version won.</p>
    <figure class="band"><img src="/images/textiles/creamsicle-colorways.webp" alt="Three colorways in pink, burgundy and jewel tones, beside the final creamsicle orange, aqua and cream version" loading="lazy" /></figure>
    <figure class="band"><img src="/images/textiles/creamsicle-bodice-flat.webp" alt="The printed bodice shown flat against a gray wall" loading="lazy" class="narrow" /><figcaption>The final <strong>bodice</strong></figcaption></figure>
  </section>

  <section class="gallery-wrap" aria-labelledby="pieces-h">
    <h2 id="pieces-h">Pieces I have made.</h2>
    <Marquee items={pieces} />
    <p class="hint">Hover to pause. Drag to explore.</p>
  </section>
</ProductLayout>

<style>
  .gallery-wrap { padding: 110px 0 90px; overflow: hidden; }
  .gallery-wrap h2 { text-align: center; font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -0.01em; margin: 0 20px 48px; }
  .hint { text-align: center; font-size: 0.95rem; color: var(--ink-3); margin: 8px 20px 0; }
  img.narrow { max-width: 460px; margin: 0 auto; }
</style>

