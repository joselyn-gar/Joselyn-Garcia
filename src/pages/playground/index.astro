---
import Base from '../../layouts/Base.astro';
import { playground } from '../../data/projects';

const img: Record<string, string> = {
  textiles: '/images/textiles/playground.webp',
  'design-social': '/images/design/playground.webp',
  jdel: '/images/jdel/bottle.webp',
};
const alt: Record<string, string> = {
  textiles: 'A wrap top, a shibori-dyed fabric, and an embroidered panel',
  'design-social': 'Two event posters side by side',
  jdel: 'JDel amber perfume bottle render',
};
---
<Base title="Playground" active="playground" description="Textiles, posters, reels, and a fragrance brand concept by Joselyn Garcia.">
  <header class="head">
    <p class="eyebrow">Free parking</p>
    <h1>The playground.</h1>
    <p class="lede">The creative side: <strong>prints</strong>, <strong>posters</strong>, <strong>reels</strong>, and a <strong>fragrance brand</strong> I dream about.</p>
  </header>

  <section class="wrap rows" aria-label="Playground work">
    {playground.map((p, i) => (
      <a class:list={['row', { flip: i % 2 === 1 }]} href={p.href} data-face={p.face} style={`--ct:var(--${p.color}-text);--t:var(--${p.color}-tint)`}>
        <span class="img"><img src={img[p.slug]} alt={alt[p.slug]} loading="lazy" /></span>
        <span class="copy">
          <span class="tags">{p.tags.join(' · ')}</span>
          <span class="title">{p.title}</span>
          <span class="sum" set:html={p.summary}></span>
          <span class="facts">
            {p.stats.filter(([, v]) => /\d/.test(v)).slice(0, 2).map(([k, v]) => <span><b>{v}</b><small>{k}</small></span>)}
          </span>
          <span class="cta">Take a look <span aria-hidden="true">→</span></span>
        </span>
      </a>
    ))}
  </section>
</Base>

<style>
  .head { padding: 150px 20px 20px; text-align: center; }
  .head h1 { font-size: clamp(3.2rem, 8vw, 6rem); margin-bottom: 0.2em; }
  .head .lede { max-width: 620px; margin: 0 auto; }
  .rows { display: grid; gap: 110px; padding-top: 90px; }
  .row { display: grid; grid-template-columns: 1.25fr 1fr; gap: 64px; align-items: center; text-decoration: none; color: var(--ink); }
  .row.flip { grid-template-columns: 1fr 1.25fr; }
  .row.flip .img { order: 2; }
  .img { display: block; aspect-ratio: 4 / 3; border-radius: 28px; overflow: hidden; background: var(--t); box-shadow: 0 24px 60px rgba(26, 26, 26, 0.14); }
  .img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .row:hover .img img { transform: scale(1.04); }
  .copy { display: block; }
  .tags { display: block; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ct); }
  .title { display: block; font-family: var(--serif); font-size: clamp(2.6rem, 4.5vw, 3.6rem); line-height: 1.02; letter-spacing: -0.01em; margin: 10px 0 14px; }
  .sum { display: block; font-size: 1.15rem; color: var(--ink-2); max-width: 440px; }
  .facts { display: flex; gap: 40px; margin: 28px 0; }
  .facts b { display: block; font-family: var(--serif); font-weight: 400; font-size: 2.4rem; line-height: 1; color: var(--ct); }
  .facts small { display: block; margin-top: 6px; font-size: 0.85rem; color: var(--ink-3); }
  .cta { font-weight: 700; color: var(--ct); }
  .row:hover .cta { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 860px) {
    .row, .row.flip { grid-template-columns: 1fr; gap: 28px; }
    .row.flip .img { order: 0; }
    .rows { gap: 80px; }
  }
</style>
