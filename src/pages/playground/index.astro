---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { playground } from '../../data/projects';

// One big visual per project, alternating sides.
const visuals: Record<string, { src: string; ratio: 'wide' | 'portrait'; alt: string }> = {
  textiles: { src: '/images/textiles/bead-singer.webp', ratio: 'portrait', alt: 'Jazz singer bead curtain print' },
  'design-social': { src: '/images/design/kiki-bouba.webp', ratio: 'portrait', alt: 'Find the Kiki to your Bouba poster' },
  jdel: { src: '/images/jdel/bottle.webp', ratio: 'wide', alt: 'JDel amber perfume bottle render' },
};
---
<Base title="Playground" active="playground" description="Textiles, posters, reels, and a fragrance brand concept by Joselyn Garcia.">
  <section class="wrap page-head">
    <p class="eyebrow">Free parking</p>
    <h1>The playground.</h1>
    <p class="lede">The creative side: <strong>prints</strong>, <strong>posters</strong>, <strong>reels</strong>, and a <strong>fragrance brand</strong> I dream about.</p>
  </section>

  <section class="wrap rows" aria-label="Playground work">
    {playground.map((p, i) => (
      <article class:list={['row-item', { flip: i % 2 === 1 }]} style={`--accent:var(--${p.color});--accent-text:var(--${p.color}-text);--tint:var(--${p.color}-tint)`}>
        <a class={`visual v-${visuals[p.slug].ratio}`} href={p.href} data-face={p.face} aria-label={p.title}>
          <Media src={visuals[p.slug].src} alt={visuals[p.slug].alt} ratio={visuals[p.slug].ratio} zoom={false} />
        </a>
        <div class="copy">
          <p class="eyebrow">{p.tags.join(' · ')}</p>
          <h2>{p.title}</h2>
          <p class="sum" set:html={p.summary}></p>
          <dl class="facts">
            {p.stats.slice(0, 2).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <a class="btn" href={p.href}>Take a look <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  .page-head { padding: 130px 0 20px; max-width: 760px; margin-left: max(20px, calc((100% - var(--wrap)) / 2)); }
  .rows { display: grid; gap: 72px; padding-top: 40px; }
  .row-item { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .row-item.flip .visual { order: 2; }
  .visual { display: block; min-width: 0; text-decoration: none; transition: transform 0.45s var(--ease); }
  .visual.v-portrait { max-width: 440px; width: 100%; justify-self: center; }
  .visual:hover { transform: translateY(-6px) rotate(-0.5deg); }
  .copy h2 { margin-bottom: 0.3em; }
  .sum { font-size: 1.1rem; color: var(--ink-2); max-width: 460px; }
  .facts { display: flex; gap: 28px; margin: 22px 0 26px; padding: 14px 0; border-top: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); }
  .facts dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .facts dd { margin: 2px 0 0; font-family: var(--serif); font-weight: 400; font-size: 1.2rem; color: var(--accent-text); }
  @media (max-width: 860px) {
    .row-item, .row-item.flip { grid-template-columns: 1fr; gap: 24px; }
    .row-item.flip .visual { order: 0; }
  }
</style>
