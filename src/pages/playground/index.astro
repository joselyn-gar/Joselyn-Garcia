---
import Base from '../../layouts/Base.astro';
import { playground } from '../../data/projects';

const img: Record<string, string> = {
  textiles: '/images/textiles/creamsicle-bodice.webp',
  'design-social': '/images/design/hero.webp',
  jdel: '/images/jdel/bottle.webp',
};
const alt: Record<string, string> = {
  textiles: 'Creamsicle print bodice on a dress form and a model',
  'design-social': 'Four event posters side by side',
  jdel: 'JDel amber perfume bottle render',
};
---
<Base title="Playground" active="playground" description="Textiles, posters, reels, and a fragrance brand concept by Joselyn Garcia.">
  <header class="head">
    <p class="eyebrow">Free parking</p>
    <h1>The playground.</h1>
    <p class="lede">The creative side: <strong>prints</strong>, <strong>posters</strong>, <strong>reels</strong>, and a <strong>fragrance brand</strong> I dream about.</p>
  </header>

  {playground.map((p, i) => (
    <a class:list={['feature', { tinted: i % 2 === 0 }]} href={p.href} data-face={p.face} style={`--ct:var(--${p.color}-text);--t:var(--${p.color}-tint)`}>
      <span class="tags">{p.tags.join(' · ')}</span>
      <span class="title">{p.title}</span>
      <span class="sum" set:html={p.summary}></span>
      <span class="cta">Take a look <span aria-hidden="true">→</span></span>
      <span class:list={['img', `i-${p.slug}`]}><img src={img[p.slug]} alt={alt[p.slug]} loading="lazy" /></span>
    </a>
  ))}
</Base>

<style>
  .head { padding: 150px 20px 90px; text-align: center; }
  .head h1 { font-size: clamp(3.2rem, 8vw, 6rem); margin-bottom: 0.2em; }
  .head .lede { max-width: 620px; margin: 0 auto; }
  .feature { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 110px 20px; text-decoration: none; color: var(--ink); }
  .feature.tinted { background: var(--t); }
  .tags { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ct); }
  .title { font-family: var(--serif); font-size: clamp(3rem, 7vw, 5.2rem); line-height: 1; margin: 12px 0 16px; }
  .sum { font-size: 1.2rem; color: var(--ink-2); max-width: 560px; }
  .cta { margin-top: 22px; padding: 12px 24px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 700; font-size: 0.98rem; transition: transform 0.3s var(--ease); }
  .feature:hover .cta { transform: translateY(-2px); }
  .img { display: block; width: min(100%, 1040px); margin-top: 60px; border-radius: 28px; overflow: hidden; box-shadow: 0 30px 80px rgba(26, 26, 26, 0.16); }
  .img img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform 0.9s var(--ease); }
  .i-design-social img { aspect-ratio: auto; }
  .feature:hover .img img { transform: scale(1.03); }
  @media (max-width: 760px) { .feature { padding: 80px 20px; } .img { margin-top: 40px; } }
</style>
