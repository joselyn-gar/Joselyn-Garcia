---
import Base from '../layouts/Base.astro';
import FlipCard from '../components/FlipCard.astro';
import { site } from '../data/site';

const tools = [
  ['Figma', 'UI, wireframes, prototypes'], ['Framer', 'interactive sites'], ['Canva', 'social + decks'],
  ['Adobe Illustrator', 'posters, prints, vector'], ['Photoshop', 'photo + mockups'], ['Procreate', 'sketching + illustration'],
  ['Blender', '3D renders'], ['Excel', 'financial projections'], ['CapCut', 'reels + recap videos'], ['Claude', 'research + building'],
];
const now = [
  ['Skandalaris Center', 'Digital Content + Website Lead Intern'],
  ['Center for Experiential Learning', 'UX Consultant, B2B platform practicum'],
  ['Adobe', 'Student Ambassador'],
  ['WUTV', 'PR Executive, membership 3 → 20'],
];
const strengths = [
  ['Arranger', 'I plan the deadlines, meetings, and agendas, then delegate by who’s available and ready.'],
  ['Learner', 'I love the process of learning, and I can break a hard topic down so it clicks for a teammate.'],
  ['Achiever', 'I keep the team ahead of deadlines, and I choose impact over doing more for the sake of it.'],
  ['Individualization', 'I spot where each teammate shines and hand out work to match.'],
  ['Input', 'I dig deep into research, then brief the team in short, usable summaries.'],
];
const hobbies = [
  { front: 'Watching baseball', back: 'Dodgers rule. That’s the whole card.', color: 'write' },
  { front: 'Upcycling', back: 'Turning thrifted pieces into cute tops, and crocheting bags when I have the patience.', color: 'tex' },
  { front: 'Pinterest boards', back: 'Collecting aesthetics and ideas. Half my projects start as a board.', color: 'lyft' },
  { front: 'Fragrance layering', back: 'Mixing scents by season. Fall is Lush Sticky Dates with a hint of Calvin Klein Escape.', color: 'jdel' },
  { front: 'Board games', back: 'Hence the dice following your cursor.', color: 'stl' },
  { front: 'Vibe coding', back: 'Building things like this site, one idea at a time.', color: 'skate' },
];
---
<Base title="About" active="about" description="About Joselyn Garcia: WashU Marketing + Entrepreneurship student, HCI minor, founder of ReLeaf Candles.">
  <header class="hero">
    <p class="eyebrow">About me</p>
    <h1>Hi, I’m Joselyn.</h1>
    <p class="tagline">Marketing + Entrepreneurship at <strong>WashU</strong>, minoring in <strong>Human-Computer Interaction</strong>.</p>
    <img class="portrait" src="/images/about/portrait.webp" alt="Joselyn Garcia smiling in a striped polo on campus" />
  </header>

  <section class="band-sec">
    <p class="pull">I love <span class="hl">client-facing work</span>, creativity, and turning an idea into something I can <span class="hl">see and test</span>.</p>
    <p class="body">That’s what led me to found <a href="/projects/releaf"><strong>ReLeaf Candles</strong></a>, and it’s how I’ve approached every project since: marketing, product, and UX, all aimed at real people.</p>
  </section>

  <section class="band-sec tinted" aria-labelledby="now-h">
    <p class="eyebrow">Right now</p>
    <h2 id="now-h">Where you’ll find me.</h2>
    <ul class="now">
      {now.map(([org, role]) => <li><b>{org}</b><span>{role}</span></li>)}
    </ul>
    <p class="also">Also: WashUX · WUMA · Net Impact · Hablo español</p>
  </section>

  <section class="band-sec" id="strengths" aria-labelledby="str-h">
    <p class="eyebrow">Clifton Strengths</p>
    <h2 id="str-h">How I show up on a team.</h2>
    <p class="hint">Hover or tap a card to flip it.</p>
    <div class="cards five">
      {strengths.map(([s, b], i) => <FlipCard kicker={`Strength ${i + 1}`} front={s} back={b} color={['skate', 'write', 'lyft', 'stl', 'tex'][i]} />)}
    </div>
  </section>

  <section class="band-sec tinted" id="toolbox" aria-labelledby="tool-h">
    <p class="eyebrow">Toolbox</p>
    <h2 id="tool-h">What I build with.</h2>
    <ul class="tools">
      {tools.map(([t, u]) => <li><b>{t}</b><span>{u}</span></li>)}
    </ul>
  </section>

  <section class="band-sec" id="away" aria-labelledby="away-h">
    <p class="eyebrow">Chance cards</p>
    <h2 id="away-h">Away from the desk.</h2>
    <div class="cards three">
      {hobbies.map((h) => <FlipCard kicker="Chance" front={h.front} back={h.back} color={h.color} />)}
    </div>
    {site.pinterest && <p><a class="btn ghost" href={site.pinterest} target="_blank" rel="noopener">See my Pinterest boards ↗</a></p>}
    <p class="site-note" id="site">This site is <strong>built like a board game</strong>, because I love them. I designed and coded it in Astro. The dice cursor can be switched off in the footer.</p>
    <div class="cta">
      <a class="btn" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn ghost" href={site.resume || "/resume"} target="_blank" rel="noopener">Resume ↗</a>
      {site.linkedin && <a class="btn ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
    </div>
  </section>
</Base>

<style>
  .hero { padding: 150px 20px 0; text-align: center; }
  .hero h1 { font-size: clamp(3.2rem, 8vw, 6rem); margin-bottom: 0.15em; }
  .tagline { font-size: clamp(1.15rem, 2vw, 1.45rem); color: var(--ink-2); max-width: 640px; margin: 0 auto; }
  .portrait { width: min(100%, 520px); aspect-ratio: 1; object-fit: cover; margin: 56px auto 0; border-radius: 28px; box-shadow: 0 30px 80px rgba(26, 26, 26, 0.16); }
  .band-sec { padding: 120px 20px; text-align: center; }
  .band-sec.tinted { background: var(--white); }
  .band-sec > * { max-width: 760px; margin-left: auto; margin-right: auto; }
  .band-sec h2 { font-size: clamp(2.6rem, 5.5vw, 4.2rem); margin-bottom: 0.5em; }
  .pull { font-family: var(--serif); font-size: clamp(1.8rem, 3.6vw, 2.8rem); line-height: 1.2; color: var(--ink); max-width: 860px !important; }
  .hl { color: var(--lyft-text); font-style: italic; }
  .body { font-size: 1.2rem; color: var(--ink-2); margin-top: 24px; }
  .now { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; max-width: 900px !important; text-align: left; }
  .now li { padding: 26px 28px; border-radius: 22px; background: var(--paper); }
  .now b { display: block; font-family: var(--serif); font-weight: 400; font-size: 1.7rem; line-height: 1.1; margin-bottom: 6px; }
  .now span { color: var(--ink-2); }
  .also { margin-top: 28px; color: var(--ink-3); }
  .hint { color: var(--ink-3); margin-top: -8px; }
  .cards { display: grid; gap: 18px; margin-top: 32px; max-width: 1100px !important; text-align: left; }
  .cards.five { grid-template-columns: repeat(5, 1fr); }
  .cards.three { grid-template-columns: repeat(3, 1fr); }
  .cards.five :global(.f) { font-size: 1.35rem; }
  .tools { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 900px !important; }
  .tools li { padding: 14px 20px; border-radius: 16px; background: var(--paper); text-align: left; }
  .tools b { display: block; font-family: var(--serif); font-weight: 400; font-size: 1.45rem; line-height: 1.1; }
  .tools span { font-size: 0.88rem; color: var(--ink-3); }
  .site-note { margin-top: 56px; color: var(--ink-2); }
  .cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
  @media (max-width: 1080px) { .cards.five { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) {
    .now { grid-template-columns: 1fr; }
    .cards.five, .cards.three { grid-template-columns: repeat(2, 1fr); }
    .band-sec { padding: 80px 20px; }
  }
  @media (max-width: 480px) { .cards.five, .cards.three { grid-template-columns: 1fr; } }
</style>
