---
// Original pewter-style game tokens, one per interest. Board-game inspired, not copies of any real set.
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
const tokens = [
  { id: 'candle', label: 'Candle token (ReLeaf)', d: 'M26 6c3 4 4 7 0 10-4-3-3-6 0-10zM18 20h16v6H18zM16 26h20l-2 26H18zM12 52h28v6H12z' },
  { id: 'perfume', label: 'Perfume bottle token (JDel)', d: 'M22 4h8v8h-8zM18 12h16v4H18zM14 16h24c4 6 4 30 0 36H14c-4-6-4-30 0-36zM10 52h32v6H10z' },
  { id: 'spool', label: 'Thread spool token (textiles)', d: 'M12 6h28v6H12zM12 46h28v6H12zM18 12h16v34H18zM16 18h20v2H16zM16 24h20v2H16zM16 30h20v2H16zM16 36h20v2H16zM10 52h32v6H10z' },
  { id: 'camera', label: 'Camera token (video)', d: 'M18 10h12l3 6h9c3 0 4 2 4 4v22c0 2-1 4-4 4H10c-3 0-4-2-4-4V20c0-2 1-4 4-4h5zM26 22a9 9 0 1 0 0.01 0zM10 52h32v6H10z' },
  { id: 'cap', label: 'Baseball cap token (Dodgers)', d: 'M8 36c0-14 8-24 20-24s18 10 18 22c-8-2-24-2-38 2zM6 38c10-4 30-4 42-1l-2 5c-14-3-28-3-38 1zM25 8h6v5h-6zM10 52h32v6H10z' },
  { id: 'scooter', label: 'Scooter token (Lyft)', d: 'M30 6h8v4h-4l-4 32h-2L32 10zM8 40h26v4H8zM12 48a5 5 0 1 0 0.01 0zM38 48a5 5 0 1 0 0.01 0zM10 52h32v6H10z' },
];
---
<ul class={`tokens ${cls}`} aria-label="Game tokens">
  {tokens.map((t, i) => (
    <li class={`tok t-${t.id}`} style={`--i:${i}`} title={t.label}>
      <svg viewBox="0 0 52 60" role="img" aria-label={t.label}>
        <defs>
          <linearGradient id={`pew-${t.id}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f4f4f2" />
            <stop offset=".45" stop-color="#b9bcc0" />
            <stop offset=".75" stop-color="#8d9196" />
            <stop offset="1" stop-color="#d9dbde" />
          </linearGradient>
        </defs>
        <path d={t.d} fill={`url(#pew-${t.id})`} fill-rule="evenodd" stroke="#6f7378" stroke-width="1" />
      </svg>
    </li>
  ))}
</ul>

<style>
  .tokens { list-style: none; margin: 0; padding: 0; display: flex; gap: 14px; justify-content: center; }
  .tok { width: 38px; height: 44px; filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.25)); animation: bob 3.6s ease-in-out calc(var(--i) * -0.6s) infinite; }
  .tok svg { width: 100%; height: 100%; }
  @keyframes bob { 50% { transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) { .tok { animation: none; } }
</style>
