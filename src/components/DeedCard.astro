---
// "Title deed" project card: color band, serif title, stat rows, a mockup peeking up from the bottom.
import type { Item } from '../data/projects';
import Img from './Img.astro';
interface Props { item: Item; }
const { item } = Astro.props;
---
<a class="deed reveal" href={item.href} style={`--c:var(--${item.color});--t:var(--${item.color}-tint);--ct:var(--${item.color}-text)`} data-face={item.face}>
  <span class="deed-band">
    <span class="deed-title">{item.title}</span>
  </span>
  <span class="deed-body">
    <span class="deed-kind">{item.kind} · {item.tags[0]}</span>
    <span class="deed-summary" set:html={item.summary}></span>
    <span class="deed-rows">
      {item.stats.map(([k, v]) => (
        <span class="deed-row"><span>{k}</span><b>{v}</b></span>
      ))}
    </span>
    <span class="deed-cta">{item.kind === 'Case study' ? 'Read case study' : 'Take a look'} <span aria-hidden="true">→</span></span>
  </span>
  {item.cover ? (
    <span class="deed-peek"><Img src={item.cover} alt="" zoom={false} /></span>
  ) : (
    <span class="deed-peek type" aria-hidden="true"><span>“{item.title}”</span></span>
  )}
</a>

<style>
  .deed {
    position: relative; display: flex; flex-direction: column; overflow: hidden; text-decoration: none; color: var(--ink);
    background: var(--t); border-radius: var(--radius-lg); border: 1.5px solid var(--ink);
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .deed:hover, .deed:focus-visible { transform: translateY(-6px) rotate(-0.6deg); box-shadow: var(--shadow-lg); }
  .deed-band { display: block; margin: 14px 14px 0; padding: 16px 18px 18px; border-radius: 16px; background: var(--c); color: #fff; text-align: center; }
  .deed-kind { display: block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: -6px; }
  .deed-title { display: block; font-family: var(--serif); font-weight: 400; letter-spacing: -0.01em; font-size: 1.9rem; line-height: 1.15; }
  .deed-body { display: flex; flex-direction: column; gap: 14px; padding: 18px 22px 20px; }
  .deed-summary { font-size: 0.95rem; color: var(--ink-2); line-height: 1.5; }
  .deed-rows { display: grid; gap: 6px; border-top: 1px dashed rgba(26, 26, 26, 0.3); padding-top: 12px; }
  .deed-row { display: flex; justify-content: space-between; gap: 12px; font-size: 0.88rem; color: var(--ink-2); }
  .deed-row b { color: var(--ink); font-weight: 650; text-align: right; }
  .deed-cta { font-weight: 600; font-size: 0.92rem; color: var(--ct); }
  .deed-peek { display: block; margin: auto 22px 0; height: 170px; overflow: hidden; border-radius: 14px 14px 0 0; background: var(--white); box-shadow: var(--shadow); }
  .deed-peek :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.6s var(--ease); }
  .deed:hover .deed-peek :global(img) { transform: scale(1.04); }
  .deed-peek.type { display: grid; place-items: center; padding: 20px; text-align: center; font-family: var(--serif); font-size: 1.6rem; color: var(--ct); background: var(--white); }
</style>
