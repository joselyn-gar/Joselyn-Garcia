---
// Every case-study image sits in one of four fixed frames, contained on a soft tint mat,
// so images of different shapes line up as a set.
//   wide 16:9 · square 1:1 · portrait 4:5 · page = scrollable window for full-page screenshots
import dims from '../data/dims.json';
interface Props {
  src: string;
  alt: string;
  ratio?: 'wide' | 'square' | 'portrait' | 'page';
  caption?: string;
  eager?: boolean;
  zoom?: boolean;
}
const { src, alt, ratio = 'wide', caption, eager = false, zoom = true } = Astro.props;
const [w, h] = (dims as Record<string, number[]>)[src] ?? [];
// small source files stay at natural size instead of being stretched blurry
const small = w && w < 700;
---
<figure class={`media ${ratio}`}>
  <div class="shell">
  <div class="frame" tabindex={ratio === 'page' ? 0 : undefined} aria-label={ratio === 'page' ? `${alt} (scrollable)` : undefined}>
    <img
      src={src}
      alt={alt}
      width={w}
      height={h}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={{ small }}
      style={small ? `max-width:min(100%, ${w}px)` : undefined}
      data-zoom={zoom ? '' : undefined}
    />
  </div>
  {ratio === 'page' && <span class="hint" aria-hidden="true">Scroll ↕</span>}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media { margin: 0; min-width: 0; }
  .frame {
    position: relative; display: grid; place-items: center; overflow: hidden;
    border-radius: var(--radius); border: 1.5px solid var(--ink);
    background: var(--tint); box-shadow: var(--shadow);
  }
  .wide .frame { aspect-ratio: 16 / 9; }
  .square .frame { aspect-ratio: 1; }
  .portrait .frame { aspect-ratio: 4 / 5; }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .frame img.small { width: auto; height: auto; max-height: 100%; margin: auto; }
  .page .frame { aspect-ratio: 3 / 4; display: block; overflow-y: auto; overscroll-behavior: contain; background: var(--white); }
  .page .frame img { position: static; height: auto; object-fit: initial; }
  .shell { position: relative; }
  .hint { position: absolute; right: 12px; bottom: 12px; padding: 4px 10px; border-radius: 999px; background: rgba(26, 26, 26, 0.82); color: #fff; font-size: 0.75rem; font-weight: 600; pointer-events: none; }
  figcaption { font-size: 0.88rem; color: var(--ink-3); margin-top: 10px; line-height: 1.45; }
</style>
