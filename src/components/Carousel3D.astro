---
// Curved card carousel: cards tilt away from the center as you scroll sideways.
import Img from './Img.astro';
interface Card { href: string; title: string; kicker: string; src?: string; color: string; face: number; }
interface Props { cards: Card[]; }
const { cards } = Astro.props;
---
<div class="c3d" data-c3d>
  <ul class="c3d-track">
    {cards.map((c) => (
      <li class="c3d-item">
        <a href={c.href} style={`--c:var(--${c.color});--t:var(--${c.color}-tint);--ct:var(--${c.color}-text)`} data-face={c.face}>
          {c.src ? <Img src={c.src} alt="" zoom={false} /> : <span class="c3d-type">“{c.title}”</span>}
          <span class="c3d-cap"><span>{c.kicker}</span><b>{c.title}</b></span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .c3d { perspective: 1400px; overflow: hidden; margin: 0 calc(50% - 50vw); padding: 20px 0 40px; }
  .c3d-track { list-style: none; margin: 0; padding: 0 max(20px, calc(50vw - 170px)); display: flex; gap: 22px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; transform-style: preserve-3d; }
  .c3d-track::-webkit-scrollbar { display: none; }
  .c3d-item { flex: 0 0 340px; scroll-snap-align: center; transform-style: preserve-3d; }
  .c3d-item a { position: relative; display: block; height: 460px; border-radius: 26px; overflow: hidden; text-decoration: none; background: var(--t); border: 1.5px solid var(--ink); transform: rotateY(var(--ry, 0deg)) scale(var(--sc, 1)); transition: transform 0.25s linear; box-shadow: var(--shadow-lg); }
  .c3d-item :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .c3d-type { display: grid; place-items: center; height: 100%; padding: 30px; font-family: var(--serif); font-style: italic; font-size: 2.4rem; text-align: center; color: var(--ct); }
  .c3d-cap { position: absolute; left: 14px; right: 14px; bottom: 14px; padding: 12px 16px; border-radius: 16px; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(8px); }
  .c3d-cap span { display: block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ct); }
  .c3d-cap b { font-family: var(--serif); font-weight: 400; font-size: 1.5rem; }
  @media (max-width: 600px) { .c3d-item { flex-basis: 78vw; } .c3d-item a { height: 400px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-c3d]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.c3d-track')!;
    const cards = [...track.querySelectorAll<HTMLElement>('.c3d-item a')];
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const update = () => {
      if (calm) return;
      const mid = innerWidth / 2;
      for (const c of cards) {
        const r = c.parentElement!.getBoundingClientRect();
        const d = Math.max(-1, Math.min(1, (r.left + r.width / 2 - mid) / mid));
        c.style.setProperty('--ry', `${-d * 28}deg`);
        c.style.setProperty('--sc', String(1 - Math.abs(d) * 0.1));
      }
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    addEventListener('resize', update);
    update();
  });
</script>
