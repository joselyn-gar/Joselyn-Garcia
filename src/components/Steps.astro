---
// Numbered horizontal steps (timeline / how-it-works). Each step: optional image, label, text.
import Img from './Img.astro';
interface Step { label: string; text?: string; src?: string; alt?: string; }
interface Props { steps: Step[]; wide?: boolean; }
const { steps, wide = false } = Astro.props;
---
<ol class:list={['steps', { wide }]} style={`--n:${steps.length}`}>
  {steps.map((s, i) => (
    <li class="step reveal">
      {s.src && <Img src={s.src} alt={s.alt ?? s.label} />}
      <span class="step-n">{i + 1}</span>
      <b>{s.label}</b>
      {s.text && <p>{s.text}</p>}
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; padding: 0; margin: 28px 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 18px; counter-reset: s; }
  .step { position: relative; background: var(--white); border-radius: var(--radius); padding: 14px 14px 18px; box-shadow: var(--shadow); }
  .step :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; margin-bottom: 14px; background: var(--paper-2); }
  .step-n { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--accent); color: #fff; font-weight: 700; font-size: 0.85rem; margin-right: 8px; }
  .step b { font-weight: 650; }
  .step p { margin: 8px 0 0; font-size: 0.92rem; color: var(--ink-2); }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
</style>
