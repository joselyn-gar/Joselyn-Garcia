---
// Official Instagram post/reel embeds. Instagram's script loads only when the grid nears the screen.
// Before it loads (or if it's blocked), each post shows as a plain link card.
interface Props { posts: { url: string; label: string }[]; handle: string; }
const { posts, handle } = Astro.props;
// Keep only the /p/ID/ or /reel/ID/ path: drops tracking params from share links.
const clean = (u: string) => {
  const m = u.match(/instagram\.com\/(p|reel)\/([\w-]+)/);
  return m ? `https://www.instagram.com/${m[1]}/${m[2]}/` : u;
};
---
<div class="ig" data-ig>
  <div class="ig-grid">
    {posts.map((p) => (
      <blockquote class="instagram-media" data-instgrm-permalink={clean(p.url)} data-instgrm-version="14">
        <a href={clean(p.url)} target="_blank" rel="noopener">
          <span class="ig-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
          </span>
          <span class="ig-label">{p.label}</span>
          <span class="ig-cta">View on Instagram →</span>
        </a>
      </blockquote>
    ))}
  </div>
  <a class="ig-follow" href={`https://www.instagram.com/${handle}/`} target="_blank" rel="noopener">Follow @{handle} <span aria-hidden="true">→</span></a>
</div>

<script>
  const root = document.querySelector('[data-ig]');
  if (root) {
    const load = () => {
      const w = window as any;
      if (w.instgrm) return w.instgrm.Embeds.process();
      const s = document.createElement('script');
      s.src = 'https://www.instagram.com/embed.js';
      s.async = true;
      document.body.appendChild(s);
    };
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
    }, { rootMargin: '600px' }).observe(root);
  }
</script>

<style>
  .ig-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .ig-grid :global(.instagram-media), .ig-grid :global(iframe.instagram-media) { margin: 0 !important; min-width: 0 !important; width: 100% !important; max-width: none !important; }
  blockquote.instagram-media { background: var(--white); border-radius: 22px; box-shadow: 0 20px 60px rgba(26, 26, 26, 0.12); }
  blockquote.instagram-media a { display: grid; place-items: center; gap: 12px; aspect-ratio: 4 / 5; padding: 24px; text-align: center; text-decoration: none; color: var(--ink); }
  .ig-mark { color: var(--accent-text); }
  .ig-label { font-family: var(--serif); font-size: 1.5rem; line-height: 1.15; }
  .ig-cta { font-weight: 700; color: var(--accent-text); }
  .ig-follow { display: inline-block; margin-top: 36px; font-weight: 700; color: var(--accent-text); text-decoration: none; }
  .ig-follow:hover { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 860px) { .ig-grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; } }
</style>
