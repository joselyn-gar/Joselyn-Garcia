---
// Minimal case-study template: big title, snapshot row, sticky contents list, one reading column.
import Base from './Base.astro';
import Img from '../components/Img.astro';
import { items, nextItem } from '../data/projects';

interface Props {
  slug: string;
  eyebrow: string;
  title: string;
  summary: string;
  hero?: string;
  heroAlt?: string;
  snapshot: [string, string][];
  section?: 'projects' | 'playground';
}
const { slug, eyebrow, title, summary, hero, heroAlt = '', snapshot, section = 'projects' } = Astro.props;
const item = items.find((i) => i.slug === slug)!;
const next = nextItem(slug);
---
<Base title={title} description={summary} active={section} color={item.color} image={hero ?? item.cover}>
  <article class="case">
    <header class="case-hero wrap">
      <a class="back" href={section === 'projects' ? '/projects' : '/playground'}>← {section === 'projects' ? 'All projects' : 'Playground'}</a>
      <p class="eyebrow case-eyebrow"><span class="swatch" aria-hidden="true"></span>{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <dl class="snapshot">
        {snapshot.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      {hero && <div class="case-cover"><Img src={hero} alt={heroAlt} eager /></div>}
    </header>

    <div class="case-grid wrap">
      <nav class="toc" aria-label="On this page" data-toc></nav>
      <div class="case-body" data-case-body>
        <slot />
      </div>
    </div>

    <a class="next wrap" href={next.href} style={`--c:var(--${next.color});--t:var(--${next.color}-tint)`} data-face={next.face}>
      <span class="eyebrow">Pass GO, next up</span>
      <span class="next-title">{next.title} <span aria-hidden="true">→</span></span>
    </a>
  </article>
</Base>

<style>
  .case-hero { padding-top: 120px; }
  .back { display: inline-block; margin-bottom: 28px; font-size: 0.9rem; color: var(--ink-3); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .case-eyebrow { display: flex; align-items: center; gap: 10px; }
  .swatch { width: 26px; height: 12px; border-radius: 4px; background: var(--accent); }
  .case-hero h1 { max-width: 16ch; }
  .case-hero .lede { max-width: 640px; }
  .snapshot { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0; margin: 36px 0 0; border-top: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); }
  .snapshot div { padding: 16px 18px 16px 0; }
  .snapshot dt { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px; }
  .snapshot dd { margin: 0; font-size: 0.95rem; }
  .case-cover { margin-top: 36px; }
  .case-cover :global(img) { width: 100%; max-height: 640px; object-fit: cover; object-position: top; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }

  .case-grid { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 56px; margin-top: 40px; }
  .case-body { min-width: 0; }
  .case-body > :global(section > *:not(.wide)) { max-width: var(--read); }
  .case-body :global(.wide) { width: 100%; margin-left: 0; transform: none; }
  .toc { position: sticky; top: 100px; align-self: start; padding-top: 60px; }
  .toc :global(a) { display: block; padding: 6px 0 6px 14px; border-left: 2px solid var(--line); font-size: 0.86rem; color: var(--ink-3); text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .toc :global(a:hover), .toc :global(a.on) { color: var(--ink); border-color: var(--accent); }
  @media (max-width: 960px) { .case-grid { grid-template-columns: 1fr; } .toc { display: none; } }

  .next { display: flex; flex-direction: column; gap: 6px; margin-top: 80px; padding: 36px 40px; border-radius: var(--radius-lg); background: var(--t); border: 1.5px solid var(--ink); text-decoration: none; transition: transform 0.4s var(--ease); }
  .next:hover { transform: translateY(-4px); }
  .next .eyebrow { margin: 0; }
  .next-title { font-family: var(--serif); font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.05; }
</style>

<script>
  // Build the sticky contents list from the section headings, and highlight the one in view.
  const body = document.querySelector('[data-case-body]');
  const toc = document.querySelector('[data-toc]');
  if (body && toc) {
    const heads = [...body.querySelectorAll<HTMLElement>('section[id] > h2')];
    toc.innerHTML = heads.map((h) => `<a href="#${h.parentElement!.id}">${h.dataset.short ?? h.textContent}</a>`).join('');
    const links = [...toc.querySelectorAll('a')];
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) {
        links.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === `#${e.target.id}`));
      }
    }, { rootMargin: '-30% 0px -60% 0px' });
    heads.forEach((h) => io.observe(h.parentElement!));
  }
</script>
